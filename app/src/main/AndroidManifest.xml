<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.google.android.googlequicksearchbox" /></queries>
    <application android:label="@string/app_name" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:icon="@drawable/ic_lens" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".CaptureActivity" android:exported="false" android:taskAffinity="" android:noHistory="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".TranslateTile" android:label="@string/app_name" android:icon="@drawable/ic_lens" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".CaptureService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="@string/app_name">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
        <provider android:name=".ImageProvider" android:authorities="local.quicklens.image" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
